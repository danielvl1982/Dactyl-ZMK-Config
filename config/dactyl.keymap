#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Keymap v1.0 for the Dactyl 4x6, see docs/03-keymap.md.
 *
 * The host must use the Spanish (ES) layout: ZMK sends HID positions and the OS
 * decides the character. Symbols that ES only reaches with AltGr are written as
 * RA(...) modifier functions, never as the US keycode of the same name.
 *
 * Layer order: base = 0, num = 1, nav = 2, sym = 3.
 */

#define LAYER_NUM 1
#define LAYER_NAV 2
#define LAYER_SYM 3

/ {
    macros {
        /*
         * ` and ^ are dead keys on the ES layout, so a literal character needs the
         * dead key followed by a space.
         */
        macro_grave: macro_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp SPACE>;
        };

        macro_caret: macro_caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT) &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
        /* L: ESC   Q     W     E     R     T  */  /* R: Y     U     I     O     P     MO(SYM) */
                &kp ESC   &kp Q      &kp W      &kp E      &kp R      &kp T        &kp Y     &kp U      &kp I       &kp O        &kp P       &mo LAYER_SYM
        /* L: TAB   A     S     D     F     G  */  /* R: H     J     K     L     N-TILDE     ACUTE   */
                &kp TAB   &kp A      &kp S      &kp D      &kp F      &kp G        &kp H     &kp J      &kp K       &kp L        &kp SEMI    &kp SQT
        /* L: LSHFT Z     X     C     V     B  */  /* R: N     M     ,     .     -     MO(NAV)  */
                &kp LSHFT &kp Z      &kp X      &kp C      &kp V      &kp B        &kp N     &kp M      &kp COMMA   &kp DOT      &kp SLASH   &mo LAYER_NAV
        /* L: ----- {     }     LCTRL LGUI  SPACE */ /* R: ENTER BSPC  FN    LALT  END   -----     */
                &none     &kp RA(SQT) &kp RA(BSLH) &kp LCTRL  &kp LGUI   &kp SPACE    &kp ENTER &kp BSPC   &mo LAYER_NUM     &kp LALT     &kp END     &none
            >;
        };

        num_layer {
            bindings = <
        /* L: NUMERAL MASCULINE 1 2 3 4 5  */  /* R: 6     7     8     9     0     ----- */
                &kp GRAVE &kp N1     &kp N2     &kp N3     &kp N4     &kp N5       &kp N6    &kp N7     &kp N8      &kp N9       &kp N0      &trans
                &trans    &trans     &trans     &trans     &trans     &trans       &trans    &trans     &trans      &trans       &trans      &trans
                &trans    &trans     &trans     &trans     &trans     &trans       &trans    &trans     &trans      &trans       &trans      &trans
                &none     &trans     &trans     &trans     &trans     &trans       &trans    &trans     &trans      &trans       &trans      &none
            >;
        };

        nav_layer {
            bindings = <
        /* L: ----- F1  F2  F3   F4   F5  */  /* R: HOME  PGDN  PGUP  END   ----- ----- */
                &none     &kp F1     &kp F2     &kp F3     &kp F4     &kp F5       &kp HOME  &kp PG_DN  &kp PG_UP   &kp END      &trans      &trans
        /* L: ----- F6  F7  F8   F9   F10 */  /* R: LEFT  DOWN  UP    RIGHT ----- ----- */
                &trans    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10      &kp LEFT  &kp DOWN   &kp UP      &kp RIGHT    &trans      &trans
        /* L: ----- F11 F12 VOL- VOL+ MUTE*/  /* R: DEL   ----- ----- ----- ----- ----- */
                &trans    &kp F11    &kp F12    &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &kp DEL &trans   &trans      &trans       &trans      &trans
        /* L: ----- PREV NEXT ----- ----- PLAY*/ /* R: ----- ----- ----- ----- ----- ----- */
                &none     &kp C_PREV &kp C_NEXT &trans     &trans     &kp C_PP     &trans    &trans     &trans      &trans       &trans      &none
            >;
        };

        sym_layer {
            bindings = <
        /* L: ----- !       @     #     $     %  */  /* R: <       `     >     +     ----- ----- */
                &trans    &kp LS(N1) &kp RA(N2) &kp RA(N3) &kp LS(N4) &kp LS(N5)   &kp NUBS       &macro_grave &kp LS(NUBS)   &kp RBKT &trans &trans
        /* L: ----- [       ]     {     }     &  */  /* R: "       '     !INV  ?     ----- ----- */
                &trans    &kp RA(LBKT) &kp RA(RBKT) &kp RA(SQT) &kp RA(BSLH) &kp LS(N6)   &kp LS(N2) &kp MINUS &kp EQUAL   &kp LS(MINUS) &trans &trans
        /* L: ----- |       \     ~     ^     *  */  /* R: C-CEDILLA ?INV ;   :     ----- ----- */
                &trans    &kp RA(N1) &kp RA(GRAVE) &kp RA(N4) &macro_caret &kp LS(RBKT) &kp BSLH &kp LS(EQUAL) &kp LS(COMMA) &kp LS(DOT) &trans &trans
        /* L: ----- (     )     /     =     _  */  /* R: ----- ----- ----- ----- ----- ----- */
                &none     &kp LS(N8) &kp LS(N9) &kp LS(N7) &kp LS(N0) &kp LS(SLASH) &trans   &trans     &trans      &trans       &trans      &none
            >;
        };
    };
};
